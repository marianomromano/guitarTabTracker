# Optional: Clerk (leave empty to use a local-only user while developing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library

# Optional: Neon Postgres. If unset, the app uses local SQLite at ./data/library.db
DATABASE_URL=

# Apple MusicKit — full-song playback in the app
# Create a MusicKit identifier and key: https://developer.apple.com/account/resources/identifiers/list/mediaId
# Register this site's domain on that identifier. Full songs need an Apple Music subscription.
APPLE_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Optional: paste a pre-made developer token instead of the key fields
APPLE_MUSIC_DEVELOPER_TOKEN=
NEXT_PUBLIC_APPLE_MUSIC_STOREFRONT=us
